        {
          "name": "Paper goods",
          "note": "Sketchbooks, notepads and other bound paper",
          "hint": "Include the item, size, paper (cream, white, grid, lined, plain), cover colours, and anything personal like names or dates."
        },
        {
          "name": "3D print",
          "note": "Clickers, keychains and other printed pieces",
          "hint": "Include what it is, roughly how big, the colours, and a link to a picture or file if you have one."
